---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import PostCard from '../components/PostCard.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Archive · Bruce Log">
  <Nav active="archive" />
  <main class="container page-main" id="main-content">
    <p class="eyebrow">02 / ARCHIVE</p>
    <h1 class="page-title">
      <span class="zh-only">
        所有<strong>记录</strong>
      </span>
      <span class="en-only">
        All <strong>records</strong>
      </span>
    </h1>
    <p class="page-lede">
      <span class="zh-only">按时间倒序排列的思考、观察与影评。</span>
      <span class="en-only">Thoughts, observations, and reviews in reverse chronological order.</span>
    </p>
    <label class="archive-search">
      <span class="sr-only">
        <span class="zh-only">搜索文章</span>
        <span class="en-only">Search notes</span>
      </span>
      <span aria-hidden="true">⌕</span>
      <input type="search" data-post-search placeholder="搜索标题、主题或内容… / Search notes…" autocomplete="off" />
    </label>
    <p class="search-empty" data-search-empty hidden>
      <span class="zh-only">没有匹配的记录。</span>
      <span class="en-only">No matching notes.</span>
    </p>
    <div class="post-list archive-list" data-search-list data-search-index={`${base}search-index.json`}>
      {posts.map((post, index) => (
        <div data-search-item data-search-id={post.id}>
          <PostCard {post} {index} />
        </div>
      ))}
    </div>
  </main>
  <script>
    const input = document.querySelector('[data-post-search]') as HTMLInputElement | null;
    const items = [...document.querySelectorAll<HTMLElement>('[data-search-item]')];
    const empty = document.querySelector<HTMLElement>('[data-search-empty]');
    const indexUrl = document.querySelector<HTMLElement>('[data-search-list]')?.dataset.searchIndex;
    type SearchEntry = { id: string; text: string };
    let searchIndex: Map<string, string> | undefined;
    const loadIndex = async () => {
      if (searchIndex) return searchIndex;
      if (!indexUrl) return new Map();
      const response = await fetch(indexUrl);
      const entries = (await response.json()) as SearchEntry[];
      searchIndex = new Map(entries.map((entry) => [entry.id, entry.text]));
      return searchIndex;
    };
    input?.addEventListener('input', async () => {
      const query = input.value.trim().toLowerCase();
      const index = query ? await loadIndex() : undefined;
      let matches = 0;
      items.forEach((item) => {
        const visible = !query || index?.get(item.dataset.searchId || '')?.includes(query);
        item.hidden = !visible;
        if (visible) matches += 1;
      });
      if (empty) empty.hidden = matches > 0;
    });
    const initialQuery = new URLSearchParams(window.location.search).get('q');
    if (initialQuery && input) {
      input.value = initialQuery;
      input.dispatchEvent(new Event('input'));
    }
  </script>
</BaseLayout>
