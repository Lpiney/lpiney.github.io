---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Giscus from '../../components/Giscus.astro';
import { readingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { zhMinutes, enMinutes } = readingTime(post.body ?? '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.subtitle || post.data.title,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Bruce Log' },
  inLanguage: ['zh-CN', 'en'],
  image: new URL(`${base}og/${post.id}.png`, Astro.site ?? Astro.url.origin).href,
  mainEntityOfPage: canonical,
};
const relatedPosts = (await getCollection('posts', ({ data }) => !data.draft && data.title !== post.data.title))
  .map((candidate) => ({ post: candidate, matches: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length }))
  .filter(({ matches }) => matches > 0)
  .sort((a, b) => b.matches - a.matches || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3);
const orderedPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const postIndex = orderedPosts.findIndex((entry) => entry.id === post.id);
const previousPost = orderedPosts[postIndex + 1];
const nextPost = orderedPosts[postIndex - 1];
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const chineseToc = tocHeadings.filter((heading) => /[\u3400-\u9fff]/.test(heading.text));
const englishToc = tocHeadings.filter((heading) => !/[\u3400-\u9fff]/.test(heading.text));
---
<BaseLayout title={`${post.data.title} · Bruce Log`} description={post.data.subtitle || post.data.title} image={`${base}og/${post.id}.png`} article={{ publishedTime: post.data.date.toISOString(), author: post.data.author }} jsonLd={jsonLd}>
  <Nav />
  <main class="container article-shell" id="main-content">
    <a class="back-link" href={`${base}archive/`}><span>←</span> <span class="zh-only">返回归档</span><span class="en-only">Archive</span></a>
    <header class="article-header">
      <p class="eyebrow"><time datetime={post.data.date.toISOString()}>{date}</time> · {post.data.author} · <span class="zh-only">{zhMinutes} 分钟阅读</span><span class="en-only">{enMinutes} MIN READ</span></p>
      <h1>{post.data.title}</h1>
      {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
      <div class="tag-row">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
    </header>
    <div class="article-reading">
      {(chineseToc.length > 0 || englishToc.length > 0) && <details class="article-toc" open>
        <summary><span class="zh-only">本页目录</span><span class="en-only">On this page</span></summary>
        <ol class="lang-zh">{chineseToc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        <ol class="lang-en">{englishToc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </details>}
      <article class="prose article-content"><Content /></article>
    </div>
    {(previousPost || nextPost) && <nav class="article-pagination" aria-label="Post navigation">
      {previousPost ? <a href={`${base}posts/${previousPost.id}/`}><span><span class="zh-only">← 上一篇</span><span class="en-only">← Previous</span></span><strong>{previousPost.data.title}</strong></a> : <span />}
      {nextPost ? <a href={`${base}posts/${nextPost.id}/`}><span><span class="zh-only">下一篇 →</span><span class="en-only">Next →</span></span><strong>{nextPost.data.title}</strong></a> : <span />}
    </nav>}
    {relatedPosts.length > 0 && <section class="related-notes" aria-label="Related notes">
      <div class="section-title"><p class="eyebrow"><span class="zh-only">继续探索</span><span class="en-only">Keep exploring</span></p><span>{String(relatedPosts.length).padStart(2, '0')} NOTES</span></div>
      <div class="related-list">{relatedPosts.map(({ post: related }) => <a href={`${base}posts/${related.id}/`}><span>{related.data.tags[0] || 'FIELD NOTE'}</span><strong>{related.data.title}</strong><b>↗</b></a>)}</div>
    </section>}
    <Giscus />
  </main>
</BaseLayout>
