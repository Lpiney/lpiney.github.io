---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <Nav active="home" />
  <main>
    <section class="hero container">
      <div class="hero-copy">
        <div class="hero-kicker"><span class="pulse"></span><span class="zh-only">任务控制中心 · 在线</span><span class="en-only">Mission control · online</span></div>
        <p class="hero-index">MISSION 01 / ONGOING</p>
        <h1><span class="zh-only">离开世界之前<br />一切都是<strong>过程</strong></span><span class="en-only">Before leaving this world,<br />everything is <strong>in progress.</strong></span></h1>
        <div class="hero-footer">
          <p class="zh-only">关于机器人、独立游戏与那些值得反复思考的科技。</p>
          <p class="en-only">Notes on robots, indie games, and technology worth thinking about twice.</p>
          <span class="hero-actions"><a href="#notes" class="text-link"><span class="zh-only">浏览文章</span><span class="en-only">Browse notes</span> <b>↓</b></a><a href={`${base}rss.xml`} class="text-link rss-link">RSS ↗</a></span>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <span class="orbit orbit-a"></span><span class="orbit orbit-b"></span><span class="orbit orbit-c"></span><span class="orbit-dot"></span>
        <div class="constellation constellation-gemini"><span></span><span></span><span></span><span></span><i>GEMINI</i></div>
        <div class="constellation constellation-orion"><span></span><span></span><span></span><span></span><i>ORION</i></div>
        <div class="signal-core"><small>BRUCE / <span data-cosmic-label>INFINITY</span></small><b data-cosmic-icon>∞</b><i>COSMIC ARCHIVE</i></div>
        <div class="signal-caption"><span>STATUS: CURIOUS</span><span>LOG / <span data-cosmic-label>INFINITY</span></span></div>
      </div>
    </section>
    <section class="home-start container" aria-labelledby="home-start-title">
      <div><p class="eyebrow">START HERE</p><h2 id="home-start-title"><span class="zh-only">三条正在展开的轨道</span><span class="en-only">Three expanding orbits</span></h2><p><span class="zh-only">宇宙、AI、次元档案：从这里选择一条线索，进入完整的个人档案。</span><span class="en-only">Space, AI, and fiction: choose a thread into the whole personal archive.</span></p></div>
      <a class="home-start-link" href={`${base}start/`}><span class="zh-only">从这里开始</span><span class="en-only">Start here</span> <b>↗</b></a>
    </section>
    <section class="notes container" id="notes">
      <div class="section-title"><p class="eyebrow"><span class="zh-only">最新信号</span><span class="en-only">Latest signals</span></p><a href={`${base}archive/`}><span>{String(posts.length).padStart(2, '0')} NOTES</span><b>↗</b></a></div>
      <div class="post-list">{posts.map((post, index) => <PostCard {post} {index} />)}</div>
    </section>
  </main>
  <footer class="footer container"><span>© {new Date().getFullYear()} BRUCE LOG</span><span class="zh-only">以好奇心持续运行</span><span class="en-only">Running on curiosity</span></footer>
</BaseLayout>
