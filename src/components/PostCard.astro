---
import type { CollectionEntry } from 'astro:content';
const { post, index = 0 } = Astro.props as { post: CollectionEntry<'posts'>; index?: number };
const date = post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<article class="post-card" style={`--delay: ${index * 70}ms`}>
  <div class="post-number">0{index + 1}</div>
  <div class="post-card-main">
    <div class="eyebrow"><time datetime={post.data.date.toISOString()}>{date}</time><span>•</span><span>{post.data.tags[0] || 'FIELD NOTE'}</span></div>
    <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
    {post.data.subtitle && <p>{post.data.subtitle}</p>}
    <div class="tag-row">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
  </div>
  <a class="post-arrow" href={`${base}posts/${post.id}/`} aria-label={`Read ${post.data.title}`}>↗</a>
</article>
