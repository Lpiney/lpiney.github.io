---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: { publishedTime: string; author: string };
}

const {
  title = 'Bruce // Field Notes',
  description = 'Robotics, independent games, and curious technology.',
  image = '/og/default.png',
  article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': article ? 'BlogPosting' : 'WebSite',
  name: title,
  headline: title,
  description,
  url: canonical,
  ...(article ? { datePublished: article.publishedTime, author: { '@type': 'Person', name: article.author }, image: imageUrl } : {}),
};
---

<!doctype html>
<html lang="zh-CN" data-lang="zh" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Bruce Log" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    <meta name="theme-color" content="#f7f7f4" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E✦%3C/text%3E%3C/svg%3E" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('bruce-theme');
        const systemTheme = window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const hour = new Date().getHours();
        const timeTheme = hour >= 19 || hour < 7 ? 'dark' : 'light';
        const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : (window.matchMedia ? systemTheme : timeTheme);
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#121212' : '#f7f7f4');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content"><span class="zh-only">跳到主要内容</span><span class="en-only">Skip to content</span></a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <slot />
    <button class="to-top" type="button" data-to-top aria-label="返回顶部">↑</button>
    <script is:inline>
      const key = 'bruce-language';
      const themeKey = 'bruce-theme';
      const applyGiscusTheme = (theme) => {
        document.querySelectorAll('.giscus-frame').forEach((frame) => {
          frame.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
        });
      };
      const resolveSystemTheme = () => window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const setTheme = (theme, persist = false) => {
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#121212' : '#f7f7f4');
        applyGiscusTheme(theme === 'dark' ? 'dark' : 'light');
        if (persist) localStorage.setItem(themeKey, theme);
        document.querySelectorAll('[data-theme-label]').forEach((node) => { node.textContent = theme === 'dark' ? '☾' : '☀'; });
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          button.setAttribute('aria-label', theme === 'dark' ? '切换为浅色模式 / Switch to light theme' : '切换为深色模式 / Switch to dark theme');
        });
      };
      const setCosmicMark = () => {
        const marks = [
          { icon: '∞', label: 'INFINITY' },
          { icon: '♊', label: 'GEMINI' },
          { icon: '✦', label: 'ORION' },
          { icon: '✧', label: 'ANDROMEDA' },
        ];
        const mark = marks[new Date().getDate() % marks.length];
        document.querySelectorAll('[data-cosmic-icon]').forEach((node) => { node.textContent = mark.icon; });
        document.querySelectorAll('[data-cosmic-label]').forEach((node) => { node.textContent = mark.label; });
      };
      const setLanguage = (language) => {
        document.documentElement.dataset.lang = language;
        document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
        localStorage.setItem(key, language);
        document.querySelectorAll('[data-language-label]').forEach((node) => {
          node.textContent = language === 'zh' ? 'EN' : '中';
        });
        const toTopLabel = language === 'zh' ? '返回顶部' : 'Back to top';
        document.querySelectorAll('[data-to-top]').forEach((button) => button.setAttribute('aria-label', toTopLabel));
      };
      setLanguage(localStorage.getItem(key) || 'zh');
      setTheme(document.documentElement.dataset.theme || resolveSystemTheme());
      setCosmicMark();
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          setTheme(nextTheme, true);
        });
      });
      window.matchMedia?.('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (!localStorage.getItem(themeKey)) setTheme(resolveSystemTheme());
      });
      const giscusObserver = new MutationObserver(() => {
        if (document.querySelector('.giscus-frame')) {
          applyGiscusTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
          giscusObserver.disconnect();
        }
      });
      giscusObserver.observe(document.body, { childList: true, subtree: true });
      document.querySelectorAll('[data-language-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          setLanguage(document.documentElement.dataset.lang === 'zh' ? 'en' : 'zh');
        });
      });
      const progress = document.querySelector('[data-scroll-progress]');
      const toTop = document.querySelector('[data-to-top]');
      document.querySelector('main')?.setAttribute('id', 'main-content');
      const updateScrollUI = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? window.scrollY / max : 0;
        progress.style.transform = `scaleX(${ratio})`;
        toTop.classList.toggle('is-visible', window.scrollY > 520);
      };
      window.addEventListener('scroll', updateScrollUI, { passive: true });
      toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      updateScrollUI();
    </script>
  </body>
</html>
